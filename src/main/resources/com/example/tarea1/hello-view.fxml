<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.tarea1.controller.UsuariosController">
    <HBox>
        <TextField fx:id="txtUsuario" text="nombre"/>
        <TextField fx:id="txtContrasena" text="contrasena"/>
        <Button fx:id="btnAgregar" onAction="#handleAgregarUsuario"/>
        <Button fx:id="btnEliminar" onAction="#handleEliminarrUsuario"/>
    </HBox>
    

    <Label fx:id="welcomeText"/>
    <Button text="Hello!" onAction="#onHelloButtonClick"/>
</VBox>
